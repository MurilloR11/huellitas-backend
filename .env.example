# --- Obligatorias -----------------------------------------------------------

# URL del proyecto de Supabase — Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co

# Llave service_role — Settings > API (secreta: nunca exponerla en el frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Secret — Settings > API
SUPABASE_JWT_SECRET=your-jwt-secret

# Llave de SendGrid para los correos de recuperación de contraseña
SENDGRID_API_KEY=SG.your-sendgrid-key

# --- Opcionales -------------------------------------------------------------

# Remitente de los correos
EMAIL_FROM=Huellitas <noreply@huellitas.app>

# URL del frontend (también se agrega a los orígenes permitidos de CORS)
FRONTEND_URL=http://localhost:5173

# Orígenes extra permitidos para CORS, separados por coma
# CORS_ORIGINS=https://tu-frontend.vercel.app

# Almacenamiento del rate limiter (memory:// por defecto; Redis si hay varios workers)
# RATELIMIT_STORAGE_URI=redis://localhost:6379

# Monitoreo de errores con Sentry
# SENTRY_DSN=

# UUID de las cuentas de demo de solo lectura, separados por coma
# DEMO_USER_IDS=

# true solo en desarrollo
FLASK_DEBUG=false
