# Supabase project URL — found in Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key — Settings > API > service_role (keep this secret, never expose to clients)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT secret — Settings > API > JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret

# Resend API key — https://resend.com/api-keys
EMAIL_API_KEY=re_your_resend_api_key

# Sender address (must be a verified domain in Resend)
EMAIL_FROM=Huellitas <noreply@yourdomain.com>

# URL of the frontend app (used in email links)
FRONTEND_URL=http://localhost:3000

# Optional: Redis URI for rate-limiter persistence across restarts
# Defaults to in-memory (not shared across workers)
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# Flask settings
FLASK_DEBUG=false
